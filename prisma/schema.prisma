// Prisma schema for the AI-Based Fiber Optic Fault Detection
// and Predictive Maintenance System (Broadband Systems Corporation).
//
// Database: PostgreSQL  |  ORM: Prisma  |  Auth: JWT (Argon2 hashed passwords)
//
// Run with:
//   npx prisma generate
//   npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMINISTRATOR
  NETWORK_ENGINEER
  OPERATIONS_STAFF
  TECHNICAL_SUPPORT
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FaultType {
  FIBER_CUT
  SIGNAL_LOSS
  SIGNAL_ATTENUATION
  CONNECTOR_DAMAGE
  REFLECTION_FAULT
  BENDING_LOSS
  EQUIPMENT_FAILURE
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FaultStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertLevel {
  INFORMATION
  WARNING
  CRITICAL
  EMERGENCY
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum DeviceType {
  OPTICAL_SIGNAL_GENERATOR
  OTDR_DEVICE
  OPTICAL_POWER_METER
  FIBER_TEST_EQUIPMENT
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TicketChannel {
  PHONE
  EMAIL
  PORTAL
  CHAT
}

enum TicketStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CLOSED
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model User {
  id        String        @id @default(cuid())
  fullName  String
  email     String        @unique
  password  String // Argon2 hash
  role      Role          @default(TECHNICAL_SUPPORT)
  status    AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  datasets       Dataset[]
  auditLogs      AuditLog[]
  assignedFaults Fault[]            @relation("AssignedFaults")
  acknowledged   Alert[]            @relation("AcknowledgedAlerts")
  assignedTasks  MaintenanceTask[]  @relation("AssignedTasks")
  createdTasks   MaintenanceTask[]  @relation("CreatedTasks")
  tickets        SupportTicket[]    @relation("CreatedTickets")

  @@index([role])
  @@index([status])
}

model PasswordResetOtp {
  id         String    @id @default(cuid())
  email      String
  otpHash    String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Dataset {
  id           String        @id @default(cuid())
  fileName     String
  fileSize     Int           @default(0)
  recordCount  Int           @default(0)
  uploadedById String
  uploadedBy   User          @relation(fields: [uploadedById], references: [id])
  uploadDate   DateTime      @default(now())
  networkData  NetworkData[]

  @@index([uploadedById])
}

model NetworkData {
  id              String   @id @default(cuid())
  signalStrength  Float
  signalLoss      Float
  errorRate       Float
  attenuation     Float
  reflectionLevel Float
  distance        Float
  networkSegment  String
  timestamp       DateTime @default(now())

  datasetId String?
  dataset   Dataset? @relation(fields: [datasetId], references: [id])
  faults    Fault[]

  @@index([networkSegment])
  @@index([timestamp])
}

model NetworkSite {
  id             String   @id @default(cuid())
  name           String
  location       String
  connectedTo    String
  distance       Float
  distanceUnit   String   @default("m")
  networkSegment String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([networkSegment])
  @@index([createdAt])
}

model Fault {
  id              String      @id @default(cuid())
  faultType       FaultType
  severity        Severity
  status          FaultStatus @default(NEW)
  confidenceScore Float
  networkSegment  String
  location        String?
  notes           String?
  detectedAt      DateTime    @default(now())
  resolvedAt      DateTime?

  assignedToId  String?
  assignedTo    User?        @relation("AssignedFaults", fields: [assignedToId], references: [id])
  networkDataId String?
  networkData   NetworkData? @relation(fields: [networkDataId], references: [id])
  alerts        Alert[]
  predictions    Prediction[]
  tasks         MaintenanceTask[]
  tickets       SupportTicket[]

  @@index([status])
  @@index([severity])
  @@index([faultType])
}

model Prediction {
  id             String    @id @default(cuid())
  networkSegment String
  riskLevel      RiskLevel
  probability    Float
  recommendation String?
  predictedAt    DateTime  @default(now())
  faultId        String?
  fault          Fault?    @relation(fields: [faultId], references: [id])

  @@index([riskLevel])
  @@index([faultId])
}

model Alert {
  id          String      @id @default(cuid())
  title       String
  description String
  level       AlertLevel
  status      AlertStatus @default(OPEN)
  createdAt   DateTime    @default(now())

  faultId          String?
  fault            Fault?    @relation(fields: [faultId], references: [id])
  acknowledgedById String?
  acknowledgedBy   User?     @relation("AcknowledgedAlerts", fields: [acknowledgedById], references: [id])
  acknowledgedAt   DateTime?

  @@index([status])
  @@index([level])
}

model SignalGenerator {
  id           String       @id @default(cuid())
  deviceName   String
  serialNumber String       @unique
  deviceType   DeviceType
  status       DeviceStatus @default(OFFLINE)
  location     String?
  lastReading  DateTime?
  createdAt    DateTime     @default(now())
}

model MaintenanceTask {
  id          String     @id @default(cuid())
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(NEW)
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  faultId      String?
  fault        Fault?  @relation(fields: [faultId], references: [id])
  assignedToId String?
  assignedTo   User?   @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdById  String?
  createdBy    User?   @relation("CreatedTasks", fields: [createdById], references: [id])

  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([faultId])
}

model SupportTicket {
  id          String       @id @default(cuid())
  subject     String
  description String?
  channel     TicketChannel @default(PORTAL)
  priority    AlertLevel    @default(INFORMATION)
  status      TicketStatus  @default(OPEN)
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?

  faultId     String?
  fault       Fault?  @relation(fields: [faultId], references: [id])
  createdById String?
  createdBy   User?   @relation("CreatedTickets", fields: [createdById], references: [id])

  @@index([status])
  @@index([priority])
  @@index([faultId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  ipAddress String?
  timestamp DateTime @default(now())

  userId String?
  user   User?  @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp])
}

# App
NEXT_PUBLIC_APP_NAME="FiberSense"
NEXT_PUBLIC_APP_VERSION="0.1.0"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL=""

# Database
DATABASE_URL="postgresql://postgres:123456@localhost:5432/fibersense?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
SEED_ADMIN_NAME="FiberSense Administrator"
SEED_ADMIN_EMAIL="admin@fibersense.local"
SEED_ADMIN_PASSWORD="replace-with-a-strong-admin-password"
PASSWORD_RESET_OTP_EXPIRES_MINUTES="10"
PASSWORD_RESET_WEBHOOK_URL=""

# Optional integrations
OTDR_API_BASE_URL=""
OTDR_API_KEY=""
ALERT_WEBHOOK_URL=""

GROQ_API_KEY="replace-with-your-groq-api-key"
GROQ_MODEL="llama-3.3-70b-versatile"
